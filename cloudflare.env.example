# Cloudflare resource IDs — copy to cloudflare.env and fill in your values.
# Run `node scripts/configure-wrangler.js` after updating to regenerate wrangler.toml.

# D1 database ID (same for dev and prod — create with: wrangler d1 create mitobyte-users)
D1_DATABASE_ID=your-d1-database-id-here

# KV namespace IDs (create with: wrangler kv namespace create FEDERATION_KV)
KV_PREVIEW_ID=your-kv-preview-namespace-id-here
KV_PROD_ID=your-kv-production-namespace-id-here
