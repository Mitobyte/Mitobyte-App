# API Configuration
# Local development (Functions run on same origin as frontend)
VITE_API_URL=

# For production, API runs on same domain as Pages site
# VITE_API_URL=

# JWT Authentication
# Secret key for signing JWT tokens (REQUIRED)
# Generate with: node scripts/generate-jwt-secret.js
# NEVER commit the actual secret to version control
JWT_SECRET=your_64_character_hex_secret_here

# OneSignal Push Notifications
# App ID is hardcoded in the service (d583c0e5-bae4-452a-be0c-c7c9156b9261)
# REST API Key for server-side operations (DO NOT expose to client-side)
# This should be set in Cloudflare Pages environment variables, not here
# ONESIGNAL_REST_API_KEY=os_v2_app_...

# Replyke Social Features
# Get these from https://replyke.com dashboard after creating a project
# Project ID (safe to expose to client-side)
VITE_REPLYKE_PROJECT_ID=your_project_id_here
# Private signing key (MUST be kept secret, used for JWT signing on server)
# REMOVE THIS - Generate a new key and store securely in environment variables
# REPLYKE_PRIVATE_KEY=DO_NOT_COMMIT_PRIVATE_KEYS
