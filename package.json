{
  "name": "arcade-spa-pwa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "npm run build && wrangler pages dev dist --d1 DB=mitobyte-users",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --d1 DB=mitobyte-users",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=mitobyte-voting",
    "db:migrate": "wrangler d1 execute mitobyte-users --file=./migrations/0001_create_users.sql",
    "db:migrate:local": "wrangler d1 execute mitobyte-users --local --file=./migrations/0001_create_users.sql",
    "db:migrate:email": "wrangler d1 execute mitobyte-users --file=./migrations/0019_add_email_digest_preferences.sql",
    "db:migrate:email:local": "wrangler d1 execute mitobyte-users --local --file=./migrations/0019_add_email_digest_preferences.sql",
    "generate-vapid-keys": "node scripts/generate-vapid-keys.js"
  },
  "dependencies": {
    "@crossmint/client-sdk-react-ui": "^1.0.0",
    "@fedify/cfworkers": "^1.9.0",
    "@fedify/fedify": "^1.8.14",
    "@langchain/cloudflare": "^1.0.0",
    "@replyke/react-js": "^6.0.8",
    "@tsndr/cloudflare-worker-jwt": "^3.2.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "html5-qrcode": "^2.3.8",
    "jose": "^6.1.0",
    "pdfjs-dist": "^5.4.296",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-onesignal": "^3.4.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "mimetext": "^3.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "vite": "^6.0.1",
    "vite-plugin-pwa": "^0.20.5",
    "web-push": "^3.6.7",
    "wrangler": "^3.91.0"
  }
}
